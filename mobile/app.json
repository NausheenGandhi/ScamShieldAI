{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.naush12.mobile",
      "permissions": [
        "READ_SMS",
        "RECEIVE_SMS",
        "READ_CONTACTS",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withSmsNative",
      "expo-sqlite",
      [
        "expo-contacts",
        {
          "contactsPermission": "ScamShield AI needs contacts access to tell known senders apart from unknown or spoofed numbers."
        }
      ]
    ]
  }
}